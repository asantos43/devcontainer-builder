{
  "name": "devcontainer-builder",
  "version": "0.1.0",
  "description": "Desktop workbench for development containers",
  "main": "out/main/index.js",
  "author": "Anderson Santos",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:docker": "node scripts/docker-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "package:win": "npm run check:release -- win32 && npm run build && electron-builder --win --x64 --publish never",
    "package:mac": "npm run build && node scripts/package-macos.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:system": "node --experimental-strip-types scripts/check-system.mjs",
    "check:release": "node scripts/check-release-signing.mjs"
  },
  "dependencies": {
    "@devcontainers/cli": "0.89.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "archiver": "7.0.1",
    "dockerode": "5.0.1",
    "electron-updater": "6.8.9",
    "jsonc-parser": "3.3.1",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tar-stream": "3.2.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/archiver": "6.0.4",
    "@types/dockerode": "3.3.47",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "globals": "16.5.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    },
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "homepage": "https://github.com/asantos43/devcontainer-builder",
  "repository": {
    "type": "git",
    "url": "https://github.com/asantos43/devcontainer-builder.git"
  },
  "desktopName": "devcontainer-builder.desktop"
}
